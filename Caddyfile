{
    on_demand_tls {
        ask http://backend:8080/api/custom-domains/ask
    }
}

:80, :443 {
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /r/* {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:80
    }

    tls {
        on_demand
    }
}